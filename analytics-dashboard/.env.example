# Copiá este archivo a .env (ya ignorado por git) y completá los valores.

# Client ID de OAuth generado en Google Cloud Console para la pantalla de
# consentimiento (tipo "Web application").
GOOGLE_CLIENT_ID=

# ID numérico de la propiedad de Google Analytics 4 a consultar (el número
# que aparece en Admin > Property details, sin el prefijo "properties/").
GA_PROPERTY_ID=
